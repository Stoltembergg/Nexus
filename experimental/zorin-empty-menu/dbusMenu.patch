+    // PopupMenu.isEmpty() ignores separators. A root with only hidden items
+    // cannot open, so waiting for active would indefinitely defer updates.
+    _canDeferUpdates() {
+        const root = this.getRoot();
+        if (!root?.hasChildren())
+            return false;
+
+        return root.getChildrenIds().some(id => {
+            const item = this._items.get(id);
+            // An incomplete cache is not evidence that the popup is empty.
+            if (!item)
+                return true;
+            return item.propertyGet('type') !== 'separator' &&
+                item.propertyGetBool('visible');
+        });
+    }
