-@@ -0,0 +1,595 @@
+@@ -0,0 +1,600 @@
 +/*
 + * dc_codesign.c - bounded Mach-O code signature parser.
 + *
@@ -11934,15 +11934,17 @@ index 00000000..d075704b
 +	if (!in_range(img->size, header_size, sizeofcmds))
 +		return fail(err, errlen, "sizeofcmds runs past end of file");
 +
