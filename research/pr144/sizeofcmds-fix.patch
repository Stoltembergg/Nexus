@@ -11955,6 +11957,9 @@ index 00000000..d075704b
 +		p += cmdsize;
 +	}
 +
++	if (p != commands_end)
++		return fail(err, errlen, "load commands do not fill sizeofcmds");
++
 +	if (!found)
 +		return fail(err, errlen, "no LC_CODE_SIGNATURE (unsigned image)");
 +	if (found > 1)
