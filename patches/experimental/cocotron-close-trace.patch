--- /dev/null
+++ b/AppKit/RCLOLCloseTrace.h
@@ -0,0 +1,8 @@
+/* Experimental, opt-in AppKit close diagnostics. */
+#include <stdlib.h>
+#include <string.h>
+
+static inline int rclolCloseTraceEnabled(void) {
+    const char *value = getenv("RCLOL_CLOSE_TRACE");
+    return value != NULL && strcmp(value, "1") == 0;
+}
