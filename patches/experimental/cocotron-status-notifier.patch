+- (BOOL) popUpMenuPositioningItem: (NSMenuItem *) item
+                       atLocation: (NSPoint) location
+                           inView: (NSView *) view
+{
+    [self update];
+    if ([[self itemArray] count] == 0)
+        return NO;
+
+    if (view != nil) {
+        location = [view convertPoint: location toView: nil];
+        if ([view window] != nil)
+            location = [[view window] convertBaseToScreen: location];
+    }
+
+    NSMenuWindow *menuWindow = [[NSMenuWindow alloc] initWithMenu: self];
+    [menuWindow setReleasedWhenClosed: YES];
+    [menuWindow setFrameTopLeftPoint: location];
+    [menuWindow orderFront: nil];
+
+    NSPoint inside = NSMakePoint(1, [menuWindow frame].size.height - 1);
+    NSEvent *event = [NSEvent mouseEventWithType: NSLeftMouseDown
+                                        location: inside
+                                   modifierFlags: 0
+                                          window: menuWindow
+                                      clickCount: 1
+                                          deltaX: 0
+                                          deltaY: 0];
+    NSMenuItem *selected = [[menuWindow menuView] trackForEvent: event];
+    [menuWindow close];
+
+    if (selected != nil)
+        [NSApp sendAction: [selected action] to: [selected target] from: selected];
+    return selected != nil;
+}
+
+- (void) cancelTracking {
+    // Cocotron tracks menus in a synchronous loop. There is no separate
+    // cancellation channel yet; accepting the call keeps clients safe.
+}
+
 + (NSZone *) menuZone {
     return NSDefaultMallocZone();
 }
