+static uint8_t *_copyARGBFromImage(NSImage *image, uint32_t *width, uint32_t *height) {
+    if (image == nil || width == NULL || height == NULL)
+        return NULL;
+    NSSize size = [image size];
+    if (size.width <= 0 || size.height <= 0)
+        return NULL;
+    const uint32_t iconWidth = 22;
+    const uint32_t iconHeight = 22;
+    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
+    CGContextRef context = CGBitmapContextCreate(NULL, iconWidth, iconHeight, 8,
+            iconWidth * 4, colorSpace,
+            kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
+    CGColorSpaceRelease(colorSpace);
+    if (context == NULL)
+        return NULL;
+
+    NSAutoreleasePool *pool = [NSAutoreleasePool new];
+    NSGraphicsContext *graphics = [NSGraphicsContext graphicsContextWithGraphicsPort:context
+                                                                            flipped:NO];
+    [NSGraphicsContext saveGraphicsState];
+    [NSGraphicsContext setCurrentContext:graphics];
+    [image drawInRect:NSMakeRect(0, 0, iconWidth, iconHeight)
+             fromRect:NSZeroRect
+            operation:NSCompositeSourceOver
+             fraction:1.0];
+    [NSGraphicsContext restoreGraphicsState];
+    [pool release];
+
+    uint8_t *source = CGBitmapContextGetData(context);
+    size_t stride = CGBitmapContextGetBytesPerRow(context);
+    uint8_t *argb = malloc((size_t)iconWidth * iconHeight * 4);
+    if (argb != NULL) {
+        for (uint32_t y = 0; y < iconHeight; y++) {
+            uint8_t *row = source + y * stride;
+            for (uint32_t x = 0; x < iconWidth; x++) {
+                uint8_t b = row[x * 4 + 0];
+                uint8_t g = row[x * 4 + 1];
+                uint8_t r = row[x * 4 + 2];
+                uint8_t a = row[x * 4 + 3];
+                if (a != 0 && a != 255) {
+                    r = (uint8_t)(((unsigned)r * 255 + a / 2) / a);
+                    g = (uint8_t)(((unsigned)g * 255 + a / 2) / a);
+                    b = (uint8_t)(((unsigned)b * 255 + a / 2) / a);
+                }
+                size_t offset = ((size_t)y * iconWidth + x) * 4;
+                argb[offset + 0] = a;
+                argb[offset + 1] = r;
+                argb[offset + 2] = g;
+                argb[offset + 3] = b;
+            }
+        }
+    }
+    CGContextRelease(context);
+    *width = iconWidth;
+    *height = iconHeight;
+    return argb;
+}
