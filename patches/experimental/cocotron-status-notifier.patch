+                    depth: (unsigned) depth
+                  entries: (DarlingStatusMenuEntry *) entries
+                    count: (unsigned *) count
+                    items: (NSMutableDictionary *) items
+                   labels: (NSMutableArray *) labels
+{
+    if (depth > 32)
+        return NO;
+    [menu update]; // Guest delegate and validation always run on the AppKit thread.
+    if (getenv("DARLING_STATUS_NOTIFIER_DEBUG")) {
+        fprintf(stderr, "STATUS_MENU_DEBUG app=%d autoenable=%d delegate=%s\n", NSApp != nil,
+            [menu autoenablesItems], [menu delegate] ? class_getName([[menu delegate] class]) : "nil");
+    }
+    NSArray *snapshot = [[menu itemArray] copy];
+    BOOL valid = YES;
+    for (NSMenuItem *item in snapshot) {
+        if (*count >= 1024) { valid = NO; break; }
+        NSNumber *identifier = nil;
+        for (NSNumber *key in _nativeMenuItems)
+            if ([_nativeMenuItems objectForKey:key] == item) { identifier = key; break; }
+        if (identifier == nil) {
+            if (_nextNativeMenuID == INT32_MAX) { valid = NO; break; }
+            identifier = [NSNumber numberWithInt:++_nextNativeMenuID];
+        }
+        // NSMenu titles have no DBusMenu mnemonic escapes.
+        NSString *label = [[item title] stringByReplacingOccurrencesOfString:@"_" withString:@"__"];
+        if (label == nil) label = @"";
+        const char *bytes = [label UTF8String];
+        if (bytes == NULL || strlen(bytes) > 4096) { valid = NO; break; }
+        [labels addObject:label];
+        uint32_t flags = ([item isEnabled] ? 1 : 0) | ([item isHidden] ? 0 : 2);
+        if (getenv("DARLING_STATUS_NOTIFIER_DEBUG") && ![item isSeparatorItem]) {
+            fprintf(stderr, "STATUS_MENU_DEBUG enabled=%d action=%d target=%s\n", [item isEnabled],
+                [item action] != NULL, [item target] ? class_getName([[item target] class]) : "nil");
+        }
+        if ([item isSeparatorItem]) flags |= 4;
+        NSInteger state = [item state];
+        if (state != 0) flags |= 8;
+        DarlingStatusMenuEntry entry = {
+            [identifier intValue], parent, bytes, flags,
+            state < 0 ? -1 : (state > 0 ? 1 : 0)
+        };
+        entries[(*count)++] = entry;
+        [items setObject:item forKey:identifier];
+        if ([item hasSubmenu]) {
+            NSMenu *submenu = [[item submenu] retain];
+            BOOL appended = NO;
+            @try {
+                appended = [self _appendNativeMenu:submenu parent:entry.id depth:depth + 1
+                    entries:entries count:count items:items labels:labels];
+            } @finally {
+                [submenu release];
+            }
+            if (!appended) { valid = NO; break; }
+        }
+    }
+    [snapshot release];
+    return valid;
+}
+
+- (void) _refreshNativeMenu {
+    if (_nativeItem == NULL || _publishingNativeMenu)
+        return;
+    _publishingNativeMenu = YES;
+    _nativeMenuDirty = NO;
+    NSMenu *menu = [_menu retain];
+    DarlingStatusMenuEntry *entries = calloc(1024, sizeof(*entries));
+    NSMutableDictionary *items = [[NSMutableDictionary alloc] init];
+    NSMutableArray *labels = [[NSMutableArray alloc] init];
+    unsigned count = 0;
+    @try {
+        BOOL valid = entries != NULL && [self _appendNativeMenu:menu parent:0 depth:1
+            entries:entries count:&count items:items labels:labels];
+        // A delegate can remove the status item or replace the menu during update.
+        if (_nativeItem != NULL && _menu == menu) {
+            if (!valid) {
+                // Never leave obsolete actionable entries on the host.
+                count = 0;
+                [items removeAllObjects];
+            }
+            if (_darlingStatus.set_menu(_nativeItem, entries, count)) {
+                [_nativeMenuItems release];
+                _nativeMenuItems = [items retain];
+            }
+        } else if (_nativeItem != NULL) {
+            _nativeMenuDirty = YES;
+            _darlingStatus.set_menu(_nativeItem, NULL, 0);
+            [_nativeMenuItems removeAllObjects];
+        }
+    } @finally {
+        free(entries);
+        [items release];
+        [labels release];
+        [menu release];
+        _publishingNativeMenu = NO;
+    }
+}
+
+- (const char *) _nativeBusName {
+    return _nativeItem != NULL && _darlingStatus.bus_name != NULL ?
+        _darlingStatus.bus_name(_nativeItem) : NULL;
+}
+
+- (void) _openNativeMenuID: (int32_t) identifier {
+    NSNumber *key = [NSNumber numberWithInt:identifier];
+    NSMenu *menu = identifier == 0 ? _menu :
+        [[_nativeMenuItems objectForKey:key] submenu];
+    if (menu == nil) return;
+    if (_nativeTrackingMenus == nil)
+        _nativeTrackingMenus = [[NSMutableDictionary alloc] init];
+    if ([_nativeTrackingMenus objectForKey:key] != menu) {
+        [menu retain];
+        @try {
+            [_nativeTrackingMenus setObject:menu forKey:key];
+            id delegate = [menu delegate];
+            if ([delegate respondsToSelector:@selector(menuWillOpen:)])
+                [delegate menuWillOpen:menu];
+            [[NSNotificationCenter defaultCenter] postNotificationName:NSMenuDidBeginTrackingNotification object:menu];
+        } @finally {
+            [menu release];
+        }
+    }
+    [self _refreshNativeMenu];
+}
+
+- (void) _closeNativeMenuID: (int32_t) identifier {
+    NSNumber *key = [NSNumber numberWithInt:identifier];
+    NSMenu *menu = [[_nativeTrackingMenus objectForKey:key] retain];
+    if (menu == nil) return;
+    [_nativeTrackingMenus removeObjectForKey:key];
+    @try {
+        id delegate = [menu delegate];
+        if ([delegate respondsToSelector:@selector(menuDidClose:)])
+            [delegate menuDidClose:menu];
+        [[NSNotificationCenter defaultCenter] postNotificationName:NSMenuDidEndTrackingNotification object:menu];
+    } @finally {
+        [menu release];
+    }
+    [self _refreshNativeMenu];
+}
+
+- (void) _closeAllNativeMenus {
+    NSArray *keys = [[_nativeTrackingMenus allKeys] copy];
+    for (NSNumber *key in keys)
+        [self _closeNativeMenuID:[key intValue]];
+    [keys release];
+}
+
+- (void) _dispatchNativeMenuID: (int32_t) identifier {
+    [self _refreshNativeMenu]; // Revalidate before acting on a queued click.
+    NSMenuItem *item = [_nativeMenuItems objectForKey:[NSNumber numberWithInt:identifier]];
+    if (!_enabled || ![item isEnabled] || [item isHidden] || [item isSeparatorItem] || [item hasSubmenu])
+        return;
+    NSMenu *menu = [item menu];
+    while (menu != nil && menu != _menu) {
+        NSMenu *parent = [menu supermenu];
+        NSInteger index = [parent indexOfItemWithSubmenu:menu];
+        NSMenuItem *owner = index == NSNotFound ? nil : [parent itemAtIndex:index];
+        if (![owner isEnabled] || [owner isHidden]) return;
+        menu = parent;
+    }
+    if (menu != _menu || menu == nil)
+        return;
+    // The action can remove this item, its menu, or the entire status item.
+    [item retain];
+    @try {
+        [NSApp sendAction:[item action] to:[item target] from:item];
+    } @finally {
+        [item release];
+    }
+    [self _refreshNativeMenu];
+}
+
+- (void) _activate {
+    if (_menu != nil && [_menu numberOfItems] > 0) {
+        [self popUpStatusItemMenu:_menu];
+        return;
+    }
+    if (_button != nil && [_button action] != NULL) {
+        [_button performClick:self];
+        return;
+    }
+    if (_action != NULL)
+        [NSApp sendAction:_action to:_target from:self];
+}
+
+- (void) _showMenuOrActivate {
+    if (_menu != nil && [_menu numberOfItems] > 0)
+        [self popUpStatusItemMenu:_menu];
+    else
+        [self _activate];
+}
+
+- (void) _pollNativeEvents {
+    if (_nativeItem == NULL || _darlingStatus.poll == NULL || _pollingNativeEvents)
+        return;
+    _pollingNativeEvents = YES;
+    @try {
+        if (_nativeMenuDirty) [self _refreshNativeMenu];
+        DarlingStatusEvent event;
+        // Actions can remove this item or enter a nested menu loop. The status
+        // bar snapshot keeps self alive, but the native pointer may become NULL.
+        unsigned budget = 128;
+        while (_nativeItem != NULL && budget-- && _darlingStatus.poll(_nativeItem, &event)) {
+            if (!_enabled)
+                continue;
+            switch (event.kind) {
+            case DarlingStatusActivate:
+                [self _activate];
+                break;
+            case DarlingStatusSecondaryActivate:
+            case DarlingStatusContextMenu:
+                [self _showMenuOrActivate];
+                break;
+            case DarlingStatusMenuClick:
+                [self _dispatchNativeMenuID:event.x];
+                break;
+            case DarlingStatusMenuOpen:
+                [self _openNativeMenuID:event.x];
+                break;
+            case DarlingStatusMenuClose:
+                [self _closeNativeMenuID:event.x];
+                break;
+            default:
+                break;
+            }
+        }
+    } @finally {
+        _pollingNativeEvents = NO;
+    }
+}
+
+- (void) _destroyNative {
+    void *native = _nativeItem;
+    _nativeItem = NULL;
+    _nativeFailed = YES; // Disable before calling application delegates below.
+    if (native != NULL && _darlingStatus.destroy != NULL)
+        _darlingStatus.destroy(native);
+    [self _closeAllNativeMenus];
+    [_nativeMenuItems removeAllObjects];
+}
