+static inline const char* _NSBaseFileName(const char* path)
+{
+    if (!path) return "";
+    const char* p = path;
+    for (const char* s = path; *s; s++) {
+        if (*s == '/' || *s == '\\') p = s + 1;
+    }
+    return p;
